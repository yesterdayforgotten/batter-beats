# Copy this file to .env and fill in your own values. .env is never committed.

# Port the app listens on.
PORT=8090

# Folder that holds the database, uploaded songs, clips and announcements.
DATA_DIR=./data

# First admin account, created only when the database has no users yet.
# If ADMIN_PASSWORD is left empty, a random password is generated and printed
# in the server log once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Which proxies to trust for the visitor's address and https detection.
# The default trusts proxies on the local network (e.g. Apache on the same LAN).
TRUST_PROXY=loopback, linklocal, uniquelocal

# Development only: host names of the https dev address in front of this server
# (comma-separated), for example dev.example.com.
DEV_HOSTS=

# The announcer's voice engine: "chatterbox" (emotion dial, voices from a
# recording) or "kokoro" (lighter, no emotion control), and where it is.
# Empty TTS_URL turns the announcer off.
TTS_ENGINE=chatterbox
TTS_URL=http://chatterbox:4123

# Optional: Murf's paid cloud voices (murf.ai), offered as a second engine under
# Admin when a key is set. Announcements are made once and stored, so the cost
# is around a cent per team.
MURF_API_KEY=

# Optional: ElevenLabs' cloud voices (elevenlabs.io), offered as another engine.
# The key needs the "Text to Speech" and "Voices" (read and write) permissions.
ELEVENLABS_API_KEY=
