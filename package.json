{
  "name": "batter-beats",
  "version": "0.1.0",
  "description": "Walkup music for baseball and softball games",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src --ignore ./data server/index.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "author": "yesterdayforgotten",
  "license": "MIT",
  "private": true,
  "type": "module",
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "engines": {
    "node": ">=22"
  }
}
