# Batter Beats development container: Claude Code plus everything needed to
# run, test and screenshot the app. The code (/workspace) and the home folder
# (/home/node: Claude's sessions and settings, git credentials, browser cache)
# are mounted from the host, so rebuilding this image never touches them.
FROM node:22-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
      # the app's audio tools
      ffmpeg mp3gain \
      # everyday tools
      git curl ca-certificates less procps lsof imagemagick \
      # libraries the headless browser needs for screenshots and UI tests
      libnspr4 libnss3 libatk1.0-0 libatk-bridge2.0-0 libcups2 libxkbcommon0 \
      libatspi2.0-0 libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 \
      libasound2 libdrm2 libxshmfence1 libpango-1.0-0 libcairo2 \
  && rm -rf /var/lib/apt/lists/*

COPY scripts/dev-container-start.sh /usr/local/bin/batter-dev-start
RUN chmod +x /usr/local/bin/batter-dev-start

USER node
WORKDIR /workspace
EXPOSE 8090
CMD ["batter-dev-start"]
